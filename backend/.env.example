# ---- Supabase (persistent users + dataset metadata) ----
# Leave empty to use the in-memory store (development only; data is lost on restart).
SUPABASE_URL=
# Use the SERVICE ROLE key: only the backend holds it and the backend enforces ownership itself.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=   # legacy anon key (still accepted, not recommended)

# ---- Server ----
PORT=3002
NODE_ENV=development
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# ---- Security (REQUIRED in production) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Shared secret between this backend and the AI service. Use the SAME value in ai-service/.env
AI_SERVICE_TOKEN=
# Optional: enables POST /api/auth/google (the ID token is verified server-side)
GOOGLE_CLIENT_ID=

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8001
# AI_RATE_LIMIT_PER_MINUTE=30
# AUTH_RATE_LIMIT_MAX=30
