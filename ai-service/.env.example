# Shared secret with the Node backend (same value as AI_SERVICE_TOKEN in backend/.env). REQUIRED.
AI_SERVICE_TOKEN=

# PostgreSQL where uploaded datasets are stored as tables (schema "user_data").
# With Supabase use the "Direct connection" / pooler string from Project Settings -> Database,
# NOT the https:// project URL.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Optional but recommended: a separate read-only role used to execute generated SQL.
# QUERY_DATABASE_URL=postgresql://datacopilot_query:password@host:5432/postgres
# QUERY_DB_ROLE=datacopilot_query

# LLM (Hugging Face). Without a key the service uses rule-based fallbacks and labels responses as such.
HUGGINGFACE_API_KEY=
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1
# HF_API_URL=https://router.huggingface.co/v1/chat/completions

AI_SERVICE_PORT=8001
AI_SERVICE_HOST=127.0.0.1
# AI_SERVICE_ALLOWED_ORIGINS=
# MAX_UPLOAD_BYTES=10485760
# MAX_RESULT_ROWS=1000
# QUERY_TIMEOUT_MS=10000
